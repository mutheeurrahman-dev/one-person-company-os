# --- Database ---
# SQLite (default, zero-setup):
DATABASE_URL=sqlite+aiosqlite:///./company_os.db
# Or PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/company_os

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM Provider ---
# Supported: anthropic | none (falls back to deterministic rule-based agents)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-sonnet-4-6

# --- App ---
APP_NAME=One-Person Company OS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
